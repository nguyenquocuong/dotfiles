for_window [class="^.*"] border pixel 1, title_format "<b> %class >> %title </b>"

gaps inner 4
gaps outer 0

font pango:monospace 11

set $Mod Mod4

set $up k
set $down j
set $left h
set $right l

set $mon1 eDP-1
set $mon2 HDMI-1

# systemd user services (xdg-desktop-portal-gtk, file dialogs) need the X display
exec_always --no-startup-id systemctl --user import-environment DISPLAY XAUTHORITY
exec_always --no-startup-id picom
exec_always --no-startup-id fcitx5 -d
exec_always --no-startup-id $HOME/.fehbg
exec_always --no-startup-id mons -a -x $HOME/dotfiles/scripts/multi-monitors.sh

exec --no-startup-id dunst

# Needed for Super to launch rofi through ksuperkey, see ~/.xprofile
bindsym $Mod+d exec --no-startup-id /usr/local/bin/rofi_run --drun

bindsym $Mod+x exec --no-startup-id /usr/local/bin/rofi_run --logout

bindsym $Mod+Shift+q kill
bindsym Mod1+q kill
bindsym Mod1+F4 kill

bindsym $Mod+q          exec --no-startup-id networkmanager_dmenu
bindsym $Mod+w          exec --no-startup-id google-chrome-stable
bindsym $Mod+e          exec --no-startup-id Thunar
bindsym $Mod+Return     exec --no-startup-id alacritty

bindsym --release Shift+Print exec --no-startup-id flameshot gui

bindsym XF86AudioPlay        exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext        exec --no-startup-id playerctl next
bindsym XF86AudioPrev        exec --no-startup-id playerctl previous
bindsym XF86AudioStop        exec --no-startup-id playerctl stop
bindsym XF86AudioMute        exec --no-startup-id pamixer -t
bindsym XF86AudioRaiseVolume exec --no-startup-id pamixer -i 2
bindsym XF86AudioLowerVolume exec --no-startup-id pamixer -d 2

bindsym XF86MonBrightnessUp   exec --no-startup-id brightnessctl s 10%+
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl s 10%-

workspace 1 output $mon1
workspace 2 output $mon1
workspace 3 output $mon1
workspace 4 output $mon1
workspace 5 output $mon1
workspace 6 output $mon1
workspace 7 output $mon1
workspace 8 output $mon1
workspace 9 output $mon1
workspace 10 output $mon1
workspace 11 output $mon2
workspace 12 output $mon2
workspace 13 output $mon2
workspace 14 output $mon2
workspace 15 output $mon2
workspace 16 output $mon2
workspace 17 output $mon2
workspace 18 output $mon2
workspace 19 output $mon2
workspace 20 output $mon2

# 1-10 are pinned to $mon1, so plain `workspace N` cannot reach $mon2
set $ws $HOME/dotfiles/scripts/i3-ws.sh

bindsym $Mod+1 exec --no-startup-id $ws $mon1 go 1
bindsym $Mod+2 exec --no-startup-id $ws $mon1 go 2
bindsym $Mod+3 exec --no-startup-id $ws $mon1 go 3
bindsym $Mod+4 exec --no-startup-id $ws $mon1 go 4
bindsym $Mod+5 exec --no-startup-id $ws $mon1 go 5
bindsym $Mod+6 exec --no-startup-id $ws $mon1 go 6
bindsym $Mod+7 exec --no-startup-id $ws $mon1 go 7
bindsym $Mod+8 exec --no-startup-id $ws $mon1 go 8
bindsym $Mod+9 exec --no-startup-id $ws $mon1 go 9
bindsym $Mod+0 exec --no-startup-id $ws $mon1 go 10

bindsym $Mod+Mod2+KP_1 exec --no-startup-id $ws $mon1 go 1
bindsym $Mod+Mod2+KP_2 exec --no-startup-id $ws $mon1 go 2
bindsym $Mod+Mod2+KP_3 exec --no-startup-id $ws $mon1 go 3
bindsym $Mod+Mod2+KP_4 exec --no-startup-id $ws $mon1 go 4
bindsym $Mod+Mod2+KP_5 exec --no-startup-id $ws $mon1 go 5
bindsym $Mod+Mod2+KP_6 exec --no-startup-id $ws $mon1 go 6
bindsym $Mod+Mod2+KP_7 exec --no-startup-id $ws $mon1 go 7
bindsym $Mod+Mod2+KP_8 exec --no-startup-id $ws $mon1 go 8
bindsym $Mod+Mod2+KP_9 exec --no-startup-id $ws $mon1 go 9
bindsym $Mod+Mod2+KP_0 exec --no-startup-id $ws $mon1 go 10

bindsym $Mod+Shift+1 exec --no-startup-id $ws $mon1 move 1
bindsym $Mod+Shift+2 exec --no-startup-id $ws $mon1 move 2
bindsym $Mod+Shift+3 exec --no-startup-id $ws $mon1 move 3
bindsym $Mod+Shift+4 exec --no-startup-id $ws $mon1 move 4
bindsym $Mod+Shift+5 exec --no-startup-id $ws $mon1 move 5
bindsym $Mod+Shift+6 exec --no-startup-id $ws $mon1 move 6
bindsym $Mod+Shift+7 exec --no-startup-id $ws $mon1 move 7
bindsym $Mod+Shift+8 exec --no-startup-id $ws $mon1 move 8
bindsym $Mod+Shift+9 exec --no-startup-id $ws $mon1 move 9
bindsym $Mod+Shift+0 exec --no-startup-id $ws $mon1 move 10

bindsym $Mod+Shift+Mod2+KP_1 exec --no-startup-id $ws $mon1 move 1
bindsym $Mod+Shift+Mod2+KP_2 exec --no-startup-id $ws $mon1 move 2
bindsym $Mod+Shift+Mod2+KP_3 exec --no-startup-id $ws $mon1 move 3
bindsym $Mod+Shift+Mod2+KP_4 exec --no-startup-id $ws $mon1 move 4
bindsym $Mod+Shift+Mod2+KP_5 exec --no-startup-id $ws $mon1 move 5
bindsym $Mod+Shift+Mod2+KP_6 exec --no-startup-id $ws $mon1 move 6
bindsym $Mod+Shift+Mod2+KP_7 exec --no-startup-id $ws $mon1 move 7
bindsym $Mod+Shift+Mod2+KP_8 exec --no-startup-id $ws $mon1 move 8
bindsym $Mod+Shift+Mod2+KP_9 exec --no-startup-id $ws $mon1 move 9
bindsym $Mod+Shift+Mod2+KP_0 exec --no-startup-id $ws $mon1 move 10

bindsym $Mod+Control+1 exec --no-startup-id $ws $mon1 go-other 1
bindsym $Mod+Control+2 exec --no-startup-id $ws $mon1 go-other 2
bindsym $Mod+Control+3 exec --no-startup-id $ws $mon1 go-other 3
bindsym $Mod+Control+4 exec --no-startup-id $ws $mon1 go-other 4
bindsym $Mod+Control+5 exec --no-startup-id $ws $mon1 go-other 5
bindsym $Mod+Control+6 exec --no-startup-id $ws $mon1 go-other 6
bindsym $Mod+Control+7 exec --no-startup-id $ws $mon1 go-other 7
bindsym $Mod+Control+8 exec --no-startup-id $ws $mon1 go-other 8
bindsym $Mod+Control+9 exec --no-startup-id $ws $mon1 go-other 9
bindsym $Mod+Control+0 exec --no-startup-id $ws $mon1 go-other 10

bindsym $Mod+Control+Mod2+KP_1 exec --no-startup-id $ws $mon1 go-other 1
bindsym $Mod+Control+Mod2+KP_2 exec --no-startup-id $ws $mon1 go-other 2
bindsym $Mod+Control+Mod2+KP_3 exec --no-startup-id $ws $mon1 go-other 3
bindsym $Mod+Control+Mod2+KP_4 exec --no-startup-id $ws $mon1 go-other 4
bindsym $Mod+Control+Mod2+KP_5 exec --no-startup-id $ws $mon1 go-other 5
bindsym $Mod+Control+Mod2+KP_6 exec --no-startup-id $ws $mon1 go-other 6
bindsym $Mod+Control+Mod2+KP_7 exec --no-startup-id $ws $mon1 go-other 7
bindsym $Mod+Control+Mod2+KP_8 exec --no-startup-id $ws $mon1 go-other 8
bindsym $Mod+Control+Mod2+KP_9 exec --no-startup-id $ws $mon1 go-other 9
bindsym $Mod+Control+Mod2+KP_0 exec --no-startup-id $ws $mon1 go-other 10

bindsym $Mod+Control+Shift+1 exec --no-startup-id $ws $mon1 move-other 1
bindsym $Mod+Control+Shift+2 exec --no-startup-id $ws $mon1 move-other 2
bindsym $Mod+Control+Shift+3 exec --no-startup-id $ws $mon1 move-other 3
bindsym $Mod+Control+Shift+4 exec --no-startup-id $ws $mon1 move-other 4
bindsym $Mod+Control+Shift+5 exec --no-startup-id $ws $mon1 move-other 5
bindsym $Mod+Control+Shift+6 exec --no-startup-id $ws $mon1 move-other 6
bindsym $Mod+Control+Shift+7 exec --no-startup-id $ws $mon1 move-other 7
bindsym $Mod+Control+Shift+8 exec --no-startup-id $ws $mon1 move-other 8
bindsym $Mod+Control+Shift+9 exec --no-startup-id $ws $mon1 move-other 9
bindsym $Mod+Control+Shift+0 exec --no-startup-id $ws $mon1 move-other 10

bindsym $Mod+Control+Shift+Mod2+KP_1 exec --no-startup-id $ws $mon1 move-other 1
bindsym $Mod+Control+Shift+Mod2+KP_2 exec --no-startup-id $ws $mon1 move-other 2
bindsym $Mod+Control+Shift+Mod2+KP_3 exec --no-startup-id $ws $mon1 move-other 3
bindsym $Mod+Control+Shift+Mod2+KP_4 exec --no-startup-id $ws $mon1 move-other 4
bindsym $Mod+Control+Shift+Mod2+KP_5 exec --no-startup-id $ws $mon1 move-other 5
bindsym $Mod+Control+Shift+Mod2+KP_6 exec --no-startup-id $ws $mon1 move-other 6
bindsym $Mod+Control+Shift+Mod2+KP_7 exec --no-startup-id $ws $mon1 move-other 7
bindsym $Mod+Control+Shift+Mod2+KP_8 exec --no-startup-id $ws $mon1 move-other 8
bindsym $Mod+Control+Shift+Mod2+KP_9 exec --no-startup-id $ws $mon1 move-other 9
bindsym $Mod+Control+Shift+Mod2+KP_0 exec --no-startup-id $ws $mon1 move-other 10

bindsym $Mod+Mod1+Left workspace prev
bindsym $Mod+Mod1+Right workspace next
bindsym Mod1+Tab workspace back_and_forth

bindsym $Mod+Shift+r restart

bindsym $Mod+Shift+c reload

bindsym $Mod+space floating toggle
floating_modifier  Mod1

bindsym $Mod+f fullscreen toggle

bindsym $Mod+Shift+z move scratchpad
bindsym $Mod+z scratchpad show

bindsym $Mod+$left  focus left
bindsym $Mod+$down  focus down
bindsym $Mod+$up    focus up
bindsym $Mod+$right focus right

bindsym $Mod+Left  focus left
bindsym $Mod+Down  focus down
bindsym $Mod+Up    focus up
bindsym $Mod+Right focus right

bindsym $Mod+p focus parent
bindsym $Mod+c focus child

bindsym $Mod+Shift+$left  move left  10px
bindsym $Mod+Shift+$down  move down  10px
bindsym $Mod+Shift+$up    move up    10px
bindsym $Mod+Shift+$right move right 10px

bindsym $Mod+Shift+Up    move up    10px
bindsym $Mod+Shift+Down  move down  10px
bindsym $Mod+Shift+Left  move left  10px
bindsym $Mod+Shift+Right move right 10px

for_window [urgent="latest"] focus
focus_on_window_activation   focus

bindsym $Mod+Shift+t layout tabbed
bindsym $Mod+Shift+s layout stacking

default_orientation horizontal

default_border normal
default_floating_border  normal

hide_edge_borders both

bindsym $Mod+shift+b border toggle

bindsym $Mod+n border normal
bindsym $Mod+y border 1pixel
bindsym $Mod+u border none

client.focused          #4c7899 #9f78e1 #ffffff #9f78e1
client.unfocused        #333333 #222222 #888888 #292d3e
client.focused_inactive #5f676a #222222 #ffffff #484e50
client.urgent           #2f343a #900000 #ffffff #900000

bindsym $Mod+plus                gaps inner current plus  5
bindsym $Mod+minus               gaps inner current minus 5
bindsym $Mod+Shift+plus          gaps outer current plus  5
bindsym $Mod+Shift+minus         gaps outer current minus 5
bindsym $Mod+Control+plus        gaps inner all     plus  5
bindsym $Mod+Control+minus       gaps inner all     minus 5
bindsym $Mod+Control+Shift+plus  gaps outer all     plus  5
bindsym $Mod+Control+Shift+minus gaps outer all     minus 5

assign [class="(?i)(?:firefox)"] → 1
assign [class="(?i)(?:geany)"]   → 2
assign [class="(?i)(?:thunar)"]  → 3

for_window [class="(?i)(?:qt5ct|pinentry|alacritty|brave-browser|flameshot)"]          floating enable, focus
for_window [title="(?i)(?:copying|deleting|moving)"] floating enable
for_window [window_role="(?i)(?:pop-up|setup)"]      floating enable

popup_during_fullscreen smart
