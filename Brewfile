brew "rustup"
brew "cargo-nextest"
# Linux C cross toolchain: `cargo zigbuild --target x86_64-unknown-linux-gnu` checks uyfb's Linux-only code on macOS
brew "zig"
brew "cargo-zigbuild"
brew "uv"
# CEF's C++ wrapper (the `cef` crate, uyfb's web pane) builds with cmake and Ninja
